{
  "name": "node-typescript-boilerplate",
  "version": "1.0.0",
  "description": "Gerenciador de podcasts - API Node.js com TypeScript e HTTP Module",
  "main": "index.js",
  "scripts": {
    "start:dev": "tsx --env-file=.env src/server.ts",
    "start:watch": "tsx watch --env-file=.env src/server.ts",
    "dist": "tsdown src",
    "start:dist": "npm run dist && node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "node",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
